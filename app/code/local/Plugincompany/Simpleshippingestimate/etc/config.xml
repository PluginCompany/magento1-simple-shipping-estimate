<config>
  <modules>
    <Plugincompany_Simpleshippingestimate>
      <version>1.1.1</version>
    </Plugincompany_Simpleshippingestimate>
  </modules>
  <global>
    <helpers>
      <simpleshippingestimate>
        <class>Plugincompany_Simpleshippingestimate_Helper</class>
      </simpleshippingestimate>
    </helpers>
	<blocks>
	  <simpleshippingestimate>
		<class>Plugincompany_Simpleshippingestimate_Block</class>
	  </simpleshippingestimate>
	</blocks>
	<models>
	  <simpleshippingestimate>
		<class>Plugincompany_Simpleshippingestimate_Model</class>
		<resourceModel>simpleshippingestimate_mysql4</resourceModel>
	  </simpleshippingestimate>
	</models>
      <rewrite>
          <simpleshippingestimate>
              <from><![CDATA[#^/checkout/cart/#]]></from>
              <to>/cartcalculator/cart/</to>
          </simpleshippingestimate>
      </rewrite>
  </global>
    <frontend>
        <routers>
            <simpleshippingestimate>
                <use>standard</use>
                <args>
                    <module>Plugincompany_Simpleshippingestimate</module>
                    <frontName>cartcalculator</frontName>
                </args>
            </simpleshippingestimate>
        </routers>
        <events>
            <controller_action_layout_generate_xml_before>
                <observers>
                    <plugincompany_simpleshippingestimate>
                        <type>model</type>
                        <class>simpleshippingestimate/observer</class>
                        <method>controllerActionLayoutGenerateXmlBefore</method>
                    </plugincompany_simpleshippingestimate>
                </observers>
            </controller_action_layout_generate_xml_before>
            <core_block_abstract_to_html_before>
                <observers>
                    <plugincompany_simpleshippingestimate>
                        <type>model</type>
                        <class>simpleshippingestimate/observer</class>
                        <method>coreBlockAbstractToHtmlBefore</method>
                    </plugincompany_simpleshippingestimate>
                </observers>
            </core_block_abstract_to_html_before>
        </events>
    </frontend>
    <default>
        <simpleshippingestimate>
            <settings>
                <active>1</active>
                <removeblock>1</removeblock>
            </settings>
        </simpleshippingestimate>
    </default>
</config>