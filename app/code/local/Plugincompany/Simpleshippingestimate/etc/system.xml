<config>
	<sections>
		<simpleshippingestimate translate="label" module="simpleshippingestimate">
				<label>Simple Shipping Estimate</label>
				<tab>sales</tab>
				<frontend_type>text</frontend_type>
				<sort_order>321</sort_order>
				<show_in_default>1</show_in_default>
				<show_in_website>1</show_in_website>
				<show_in_store>1</show_in_store>
				<groups>
					<settings translate="label">
						<label>General Settings</label>
						<frontend_type>text</frontend_type>
						<sort_order>0</sort_order>
						<show_in_default>1</show_in_default>
						<show_in_website>1</show_in_website>
						<show_in_store>1</show_in_store>
                        <expanded>1</expanded>
						<fields>
							<active translate="label">
								<label>Enable extension</label>
								<frontend_type>select</frontend_type>
								<source_model>adminhtml/system_config_source_yesno</source_model>
								<sort_order>1</sort_order>
								<show_in_default>1</show_in_default>
								<show_in_website>1</show_in_website>
								<show_in_store>1</show_in_store>
                                <comment>Select 'Yes' to enable Simple Shipping Estimate on the front-end.</comment>
							</active>
                            <removeblock translate="label">
                                <label>Front-end block style</label>
                                <frontend_type>select</frontend_type>
                                <source_model>simpleshippingestimate/source_calculateblock</source_model>
                                <sort_order>2</sort_order>
                                <show_in_default>1</show_in_default>
                                <show_in_website>1</show_in_website>
                                <show_in_store>1</show_in_store>
                                <default>1</default>
                                <comment>Choose how to display the shipping estimate block in the shopping cart.</comment>
                            </removeblock>
						</fields>
					</settings>
					<origin translate="label">
						<label>Default Shipping Destination</label>
						<frontend_type>text</frontend_type>
						<sort_order>1</sort_order>
						<show_in_default>1</show_in_default>
						<show_in_website>1</show_in_website>
						<show_in_store>1</show_in_store>
                        <expanded>1</expanded>
                        <comment>The pre-filled shipping destination based on which the default shipping rate is calculated in the shopping cart.</comment>
						<fields>
							<postcode translate="label">
								<label>ZIP/Postal Code</label>
								<frontend_type>text</frontend_type>
								<sort_order>10</sort_order>
								<show_in_default>1</show_in_default>
								<show_in_website>1</show_in_website>
								<show_in_store>0</show_in_store>
							</postcode>
                            <region_id translate="label">
                                <label>Region/State</label>
                                <frontend_type>text</frontend_type>
                                <sort_order>30</sort_order>
                                <show_in_default>1</show_in_default>
                                <show_in_website>1</show_in_website>
                                <show_in_store>0</show_in_store>
                            </region_id>
                            <city translate="label">
                                <label>City</label>
                                <frontend_type>text</frontend_type>
                                <sort_order>20</sort_order>
                                <show_in_default>1</show_in_default>
                                <show_in_website>1</show_in_website>
                                <show_in_store>0</show_in_store>
                            </city>
                            <country_id translate="label">
                                <label>Country</label>
                                <frontend_type>select</frontend_type>
                                <frontend_class>countries</frontend_class>
                                <source_model>adminhtml/system_config_source_country</source_model>
                                <sort_order>40</sort_order>
                                <show_in_default>1</show_in_default>
                                <show_in_website>1</show_in_website>
                                <show_in_store>0</show_in_store>
                                <validate>required-entry</validate>
                            </country_id>
						</fields>
					</origin>
                    <shipping>
                        <label>Default Shipping Method</label>
                        <sort_order>2</sort_order>
                        <show_in_default>1</show_in_default>
                        <show_in_website>1</show_in_website>
                        <show_in_store>1</show_in_store>
                        <expanded>1</expanded>
                        <fields>
                            <method>
                                <label>Shipping method</label>
                                <frontend_type>select</frontend_type>
                                <source_model>simpleshippingestimate/source_shippingmethods</source_model>
                                <show_in_default>1</show_in_default>
                                <show_in_store>1</show_in_store>
                                <show_in_website>1</show_in_website>
                                <comment>The pre-selected shipping method based on which the default shipping rate is calculated in the shopping cart.</comment>
                            </method>
                        </fields>
                    </shipping>
				</groups>
		</simpleshippingestimate>
	</sections>

</config>
